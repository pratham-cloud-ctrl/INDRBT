(version 1)
(rule "Minimum copper clearance 0.20 mm"
 (constraint clearance (min 0.20mm)))
(rule "Copper to mechanical edge 0.50 mm"
 (constraint edge_clearance (min 0.50mm)))
(rule "Minimum track width 0.20 mm"
 (constraint track_width (min 0.20mm)))
(rule "Minimum via annular ring 0.15 mm"
 (constraint annular_width (min 0.15mm)))
(rule "Minimum drilled-hole spacing 0.25 mm"
 (constraint hole_to_hole (min 0.25mm)))
(rule "Minimum copper to unrelated drilled hole 0.25 mm"
 (constraint hole_clearance (min 0.25mm)))
